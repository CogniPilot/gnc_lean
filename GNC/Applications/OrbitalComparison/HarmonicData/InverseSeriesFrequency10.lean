theorem physical_prediction (φ : ℝ) : ∀ t ∈ Icc (0:ℝ) 1,
    ‖(HarmonicBurn.trajectory (data.frequency:ℝ) φ).p t-data.position φ t‖ ≤ (1/100:ℝ) ∧
    ‖(HarmonicBurn.trajectory (data.frequency:ℝ) φ).v t-data.velocity φ t‖/600 ≤ (1/10000:ℝ) := by
  intro t ht
  have h := data.physical_prediction valid φ t ht
  have hp : (data.positionError:ℝ) ≤ ((1/100:ℚ):ℝ) := Rat.cast_le.mpr accuracy.1
  have hv : (data.velocityError:ℝ) ≤ ((1/10000:ℚ):ℝ) := Rat.cast_le.mpr accuracy.2
  exact ⟨h.1.trans (by simpa using hp),h.2.trans (by simpa using hv)⟩

theorem physical_tube (φ : ℝ) : ∀ t ∈ Icc (0:ℝ) 1,
