  have hp : ((data.displacementBound+data.positionError:ℚ):ℝ) ≤ (((17/50):ℚ):ℝ) :=
    Rat.cast_le.mpr tube_bounds.1
  have hv : (data.physicalVelocityBound:ℝ) ≤ (((1687/1000000):ℚ):ℝ) :=
    Rat.cast_le.mpr tube_bounds.2
  constructor
  · exact (data.physical_displacement valid φ ht).trans (by simpa using hp)
  · exact (data.physical_velocity valid φ ht).trans (by simpa using hv)

