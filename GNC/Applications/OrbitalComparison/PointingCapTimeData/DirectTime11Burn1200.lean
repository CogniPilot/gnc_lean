theorem valid : profile.Valid data := by
  constructor
  case residual =>
    constructor
    · intro k
      fin_cases k <;> decide +kernel
    · intro i
      fin_cases i <;> decide +kernel
  case envelope => decide +kernel
  case region => decide +kernel

theorem position_limit : profile.positionError≤(1114279/125000000) := by decide +kernel
theorem velocity_limit : profile.velocityError data≤(53744171/1000000000000) := by decide +kernel

theorem prediction {x : Fin 3 → ℝ} (hx : Admissible (data.sigma:ℝ) x)
    (X : Motion (data.alpha:ℝ) (direction x)) :
    ∀ t ∈ Icc (0:ℝ) 1, ‖X.p t-data.position x t‖≤(1114279/125000000) ∧
      ‖X.v t-data.velocity x t‖/(600*(data.alpha:ℝ))≤(53744171/1000000000000) := by
  intro t ht
  have h := profile.certifies data PointingCapData.DirectTime11Burn1200.valid valid hx X t ht
  have hp : (profile.positionError:ℝ)≤(((1114279/125000000):ℚ):ℝ) := by exact_mod_cast position_limit
  have hv : (profile.velocityError data:ℝ)≤(((53744171/1000000000000):ℚ):ℝ) := by exact_mod_cast velocity_limit
  exact ⟨h.1.trans (by simpa using hp),h.2.trans (by simpa using hv)⟩

theorem physical_prediction {x : Fin 3 → ℝ} (hx : Admissible (data.sigma:ℝ) x) :
    ∃ X : Motion (data.alpha:ℝ) (direction x), ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-data.position x t‖≤(1114279/125000000) ∧
      ‖X.v t-data.velocity x t‖/(600*(data.alpha:ℝ))≤(53744171/1000000000000) :=
  ⟨data.trajectory PointingCapData.DirectTime11Burn1200.valid x hx,
    prediction hx (data.trajectory PointingCapData.DirectTime11Burn1200.valid x hx)⟩

