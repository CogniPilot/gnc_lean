theorem prediction {x : Fin 3 → ℝ} (hx : Admissible (data.sigma:ℝ) x)
    (X : Motion (data.alpha:ℝ) (direction x)) :
    ∀ t ∈ Icc (0:ℝ) 1, ‖X.p t-data.position x t‖≤(1340259/1000000000) ∧
      ‖X.v t-data.velocity x t‖/(600*(data.alpha:ℝ))≤(9834489/1000000000000) := by
  intro t ht
  have h := profile.certifies data PointingCapData.MixedCorrectionTime11Degree8Burn1200.valid valid hx X t ht
  have hp : (profile.positionError:ℝ)≤(((1340259/1000000000):ℚ):ℝ) := by exact_mod_cast position_limit
  have hv : (profile.velocityError data:ℝ)≤(((9834489/1000000000000):ℚ):ℝ) := by exact_mod_cast velocity_limit
  exact ⟨h.1.trans (by simpa using hp),h.2.trans (by simpa using hv)⟩

