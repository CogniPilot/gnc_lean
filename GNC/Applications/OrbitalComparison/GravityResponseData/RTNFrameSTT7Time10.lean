theorem prediction {θ : ℝ} (X : PhysicalOrbit .rtnReferenceOffset θ) (hθ : |θ| ≤ 7/20) :
    ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-position SpatialSources.ordinary data.q θ t‖ ≤ (7326497/250000000000) ∧
      ‖X.v t-velocity SpatialSources.ordinary data.q θ t‖/600 ≤ (2858229/12500000000000) := by
  have hp : (data.positionLimit:ℝ) = (7326497/250000000000) := by norm_num [data]
  have hv : (data.velocityLimit:ℝ) = (2858229/12500000000000) := by norm_num [data]
  simpa only [hp,hv] using data.certifies SpatialSources.ordinary SpatialSources.polynomial24Time .rtnReferenceOffset valid X
    (show |θ| ≤ (UniformCertificate.angle:ℝ) by simpa [UniformCertificate.angle] using hθ)

theorem relative_prediction {θ : ℝ} (X : PhysicalOrbit .rtnReferenceOffset θ)
    (X₀ : PhysicalOrbit .rtnReferenceOffset 0) (hθ : |θ| ≤ 7/20) :
    ∀ t ∈ Icc (0:ℝ) 1,
      ‖(X.p t-X₀.p t)-(position SpatialSources.ordinary data.q θ t-position SpatialSources.ordinary data.q 0 t)‖ ≤ 2*(7326497/250000000000) ∧
      ‖(X.v t-X₀.v t)-(velocity SpatialSources.ordinary data.q θ t-velocity SpatialSources.ordinary data.q 0 t)‖/600 ≤ 2*(2858229/12500000000000) := by
  have hp : (data.positionLimit:ℝ) = (7326497/250000000000) := by norm_num [data]
  have hv : (data.velocityLimit:ℝ) = (2858229/12500000000000) := by norm_num [data]
  simpa only [hp,hv] using data.relative_certifies SpatialSources.ordinary SpatialSources.polynomial24Time .rtnReferenceOffset valid X X₀
    (show |θ| ≤ (UniformCertificate.angle:ℝ) by simpa [UniformCertificate.angle] using hθ)

