  have hv : (data.velocityLimit:ℝ) = (1422069/10000000000000) := by norm_num [data]
  simpa only [hp,hv] using data.certifies SpatialSources.circle WeightedCertificate.circleTime .rtnReferenceOffset valid X
    (show |θ| ≤ (UniformCertificate.angle:ℝ) by simpa [UniformCertificate.angle] using hθ)

