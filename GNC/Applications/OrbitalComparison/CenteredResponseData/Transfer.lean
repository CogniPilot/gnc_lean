def radialPolynomial : List ℚ := [(16757883/535937500000),(-3231/2500000000),(-1/40000000000)]
def slope : ℚ := (1/200000)
def forcePolynomial : Vector :=
  ![PolynomialBounds.subtract (PolynomialBounds.multiply radialPolynomial (reference 0))
      (PolynomialBounds.scale slope (reference 1)),
    PolynomialBounds.add (PolynomialBounds.multiply radialPolynomial (reference 1))
