import GNC.Analysis.CircleEvaluation
import GNC.Applications.OrbitalComparison.SpatialData.RTNFrameCircleTime14

/-! Generated finite witness; every numerical claim is checked by Lean.
The rational nodes approximate Chebyshev extrema, but no approximation to
those extrema is assumed in the proof. All moments vanish exactly.
Point output is rounded to nanometres; its complete evaluation error is
computed and charged, rather than supplied as a physical allowance.
-/
namespace GNC.OrbitalComparison.PolynomialObstructionData
open CircleEvaluation SpatialData
set_option maxRecDepth 100000
set_option maxHeartbeats 0

def nodes : Fin 8 → ℚ := ![(7/20), (3153/10000), (1091/5000), (779/10000), (-779/10000), (-1091/5000), (-3153/10000), (-7/20)]
def weights : Fin 8 → ℚ := ![(1196176712127304181/16766087986599076862), (-537695558064022575/3765209819132812259), (6332430938262575/44302217758367811), (-45733681543787375/320013749892871551), (45733681543787375/320013749892871551), (-6332430938262575/44302217758367811), (537695558064022575/3765209819132812259), (-1196176712127304181/16766087986599076862)]
def reported : Fin 8 → ℚ := ![(4215765475402157/1000000000), (1053926346228303/250000000), (2107764652886183/500000000), (2107628517354993/500000000), (2107467928147327/500000000), (842927178983931/200000000), (4214425554985419/1000000000), (210717514587769/50000000)]
def sampleError : Fin 8 → ℚ := ![(), (), (), (), (), (), (), ()]
def physicalError : ℚ := 220659/1000000000000
def lowerBound : ℚ := |∑ i, weights i*reported i| -
  ∑ i, |weights i| * (sampleError i+physicalError)

def pointExpr : PolynomialODE.Expr 2 :=
  .multiply (.constant 7000000) (expression (RTNFrameCircleTime14.data.q 1) 1)

theorem moments : ∀ k : Fin 7, ∑ i, weights i*nodes i^k.val = 0 := by decide +kernel
theorem total_variation : ∑ i, |weights i| = 1 := by decide +kernel
theorem angles : ∀ i, |nodes i| ≤ 7/20 := by decide +kernel
theorem regions : ∀ i j, |center (nodes i) j|+radius (nodes i) ≤ 1 := by decide +kernel

theorem samples_checked (i : Fin 8) :
    pointExpr.differenceMajorant (fun _ => 1) (fun _ => radius (nodes i))+
      |pointExpr.ratValue (center (nodes i))-reported i| ≤ sampleError i := by
  fin_cases i <;> decide +kernel

theorem lower_bound_checked : (388/100000000:ℚ) < lowerBound := by decide +kernel

end GNC.OrbitalComparison.PolynomialObstructionData
