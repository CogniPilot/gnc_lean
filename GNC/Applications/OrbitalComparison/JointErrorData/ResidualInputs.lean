set_option maxRecDepth 100000
set_option Elab.async false
namespace GNC.OrbitalComparison.JointErrorData
open ParameterPolynomial BallPolynomialEnclosure DegreeProductCertificate

def cubeDeviation : BallPolynomialEnclosure.Partition where
  count := 8
  blocks := ![⟨1,offsetCubePart1,cubeDeviationRange1⟩,
⟨2,offsetCubePart2,cubeDeviationRange2⟩,
⟨3,offsetCubePart3,cubeDeviationRange3⟩,
⟨4,offsetCubePart4,cubeDeviationRange4⟩,
⟨5,offsetCubePart5,cubeDeviationRange5⟩,
⟨6,offsetCubePart6,cubeDeviationRange6⟩,
⟨7,offsetCubePart7,cubeDeviationRange7⟩,
⟨8,offsetCubePart8,cubeDeviationRange8⟩]

theorem cubeDeviation_checked : cubeDeviation.Valid (mkRat (1) 10) := by
  intro i
  fin_cases i
  · exact cubeDeviationRange1_checked
  · exact cubeDeviationRange2_checked
  · exact cubeDeviationRange3_checked
  · exact cubeDeviationRange4_checked
  · exact cubeDeviationRange5_checked
  · exact cubeDeviationRange6_checked
  · exact cubeDeviationRange7_checked
  · exact cubeDeviationRange8_checked


theorem cubeDeviation_value (x : Fin 3 → ℝ) (t : ℝ) :
    value cubeDeviation.core x t=value offsetCube x t-1 := by
  have h (i : Fin 8) : (cubeDeviation.blocks i).core=offsetCubePieces i.succ := by
    fin_cases i <;> rfl
  have hs : (∑ i : Fin 8, value (cubeDeviation.blocks i).core x t)=
      ∑ i : Fin 8, value (offsetCubePieces i.succ) x t := by
    exact Finset.sum_congr rfl (fun i _ => congrArg (fun p => value p x t) (h i))
  rw [Partition.core,polynomialSum_value,offsetCube,assemble_value,Fin.sum_univ_succ]
  change (∑ i : Fin 8, value (cubeDeviation.blocks i).core x t)=
    value (offsetCubePieces 0) x t+(∑ i : Fin 8, value (offsetCubePieces i.succ) x t)-1
  rw [hs]
  have h0 : value (offsetCubePieces 0) x t=1 := by
    simp [offsetCubePieces,offsetCubePart0,value,termValue,monomial,
      PolynomialOrder.value,Planning.PolynomialKernel.evaluate]
  rw [h0]
  ring
