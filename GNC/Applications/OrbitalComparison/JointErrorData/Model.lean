  intro i
  fin_cases i <;> decide +kernel

theorem coupled_value (x : Fin 3 → ℝ) (t : ℝ) :
    value3 coupledCore x t=value3 modelInput.coupled x t := by
  ext i
  exact (ParameterPolynomial.identity _ _ (coupled_checked i) x t).symm

theorem baseResidual_value (x : Fin 3 → ℝ) (t : ℝ) :
    value3 baseResidualCore x t=value3 modelInput.baseResidual x t := by
  ext i
  exact (ParameterPolynomial.identity _ _ (baseResidual_checked i) x t).symm

end GNC.OrbitalComparison.JointErrorData
