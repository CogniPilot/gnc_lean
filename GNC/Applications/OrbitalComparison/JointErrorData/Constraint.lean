theorem constraintTail_checked : PolynomialOrder.nonnegative (PolynomialBounds.subtract
    constraintTail (PolynomialBounds.add (discardedProfile 8 radiusPartition offsetSquare)
      (PolynomialBounds.multiply offsetSquare.bound radiusTail))) := by
  decide +kernel

def constraintBound : List ℚ := PolynomialBounds.add constraintPartition.bound constraintTail

/-- The actual inverse-radius polynomial satisfies the complete scalar
constraint uniformly on the attitude ball, with every omitted product charged. -/
theorem constraint_bound {x : Fin 3 → ℝ} {t : ℝ}
    (hx : x 0^2+x 1^2+x 2^2≤((1/10:ℚ):ℝ)^2) (ht : 0≤t) :
    |value modelInput.constraint x t|≤PolynomialOrder.value constraintBound t := by
  have hsigma : mkRat 1 10=(1/10:ℚ) := by decide +kernel
  have hx' : x 0^2+x 1^2+x 2^2≤((mkRat 1 10:ℚ):ℝ)^2 := by simpa only [hsigma] using hx
  have hsquare : offsetSquare.Valid (mkRat 1 10) := by
    simpa only [hsigma] using offsetSquare_checked
  have hc := affine_error 8 radiusPartition offsetSquare 1 (by norm_num)
    constraintBase constraintPieces constraintPieces_checked
    radiusPartition_checked hsquare hx' ht
  rw [constraintBase_value,←constraintPartition_value] at hc
  simp only [Rat.cast_one,one_mul] at hc
  have hr := radius_error hx ht
  have hs := offsetSquare.certifies offsetSquare_checked hx ht
  have he : |value modelInput.radius x t*value offsetSquare.core x t-1-
      (-1+value radiusPartition.core x t*value offsetSquare.core x t)|≤
      PolynomialOrder.value offsetSquare.bound t*PolynomialOrder.value radiusTail t := by
    have hid : value modelInput.radius x t*value offsetSquare.core x t-1-
        (-1+value radiusPartition.core x t*value offsetSquare.core x t)=
        value offsetSquare.core x t*(value modelInput.radius x t-value radiusPartition.core x t) := by ring
    rw [hid,abs_mul]
    exact mul_le_mul hs hr (abs_nonneg _) ((abs_nonneg _).trans hs)
  have hcombined := (abs_add_le
    (value modelInput.radius x t*value offsetSquare.core x t-1-
      (-1+value radiusPartition.core x t*value offsetSquare.core x t))
    (-1+value radiusPartition.core x t*value offsetSquare.core x t-
      value constraintPartition.core x t)).trans (add_le_add he hc)
  have heq : value modelInput.radius x t*value offsetSquare.core x t-1-
      (-1+value radiusPartition.core x t*value offsetSquare.core x t)+
      (-1+value radiusPartition.core x t*value offsetSquare.core x t-value constraintPartition.core x t)=
      value modelInput.constraint x t-value constraintPartition.core x t := by
    rw [modelInput.constraint_value,offsetSquare_value]
    rw [show modelInput.h=inverseOffset from rfl]
    ring
  rw [heq] at hcombined
  have htail := PolynomialOrder.value_nonnegative _ constraintTail_checked ht
  rw [PolynomialOrder.value_subtract,PolynomialOrder.value_add,DiskPolynomial.value_multiply] at htail
  have herr : |value modelInput.constraint x t-value constraintPartition.core x t|≤
      PolynomialOrder.value constraintTail t := by linarith
  have hbound := constraintPartition.certifies constraintPartition_checked hx' ht
  rw [constraintBound,PolynomialOrder.value_add]
  have h := (abs_add_le (value constraintPartition.core x t)
    (value modelInput.constraint x t-value constraintPartition.core x t)).trans
    (add_le_add hbound herr)
  simpa only [add_sub_cancel] using h

end GNC.OrbitalComparison.JointErrorData
