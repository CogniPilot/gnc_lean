theorem radius_error {x : Fin 3 → ℝ} {t : ℝ}
    (hx : x 0^2+x 1^2+x 2^2≤((1/10:ℚ):ℝ)^2) (ht : 0≤t) :
    |value modelInput.radius x t-value radiusPartition.core x t|≤PolynomialOrder.value radiusTail t := by
  have hs : mkRat 1 10=(1/10:ℚ) := by decide +kernel
  have hx' : x 0^2+x 1^2+x 2^2≤((mkRat 1 10:ℚ):ℝ)^2 := by simpa only [hs] using hx
  have h := sumProduct_error 8 radiusLeft radiusRight radiusBasePieces radiusPieces
    radiusPieces_checked radiusLeft_checked radiusRight_checked hx' ht
  rw [radiusBase_value] at h
  simp_rw [radiusLeft_value,radiusRight_value] at h
  rw [←modelInput.radius_factored,←radiusPartition_value] at h
  have he := PolynomialOrder.value_nonnegative _ radiusTail_checked ht
  rw [PolynomialOrder.value_subtract] at he
  exact h.trans (sub_nonneg.mp he)

