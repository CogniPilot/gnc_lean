private theorem reduction_0 : ParameterPolynomial.zero
    (ParameterPolynomial.subtract (record.rawResidual 0)
      (ParameterPolynomial.add (record.remainder 0)
        (ParameterPolynomial.multiply (VaryingRatePolynomial.constraint record.kind) (record.witness 0)))) := by
