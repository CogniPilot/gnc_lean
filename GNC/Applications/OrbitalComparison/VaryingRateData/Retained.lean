theorem velocity_display : record.velocityError≤((8609/25000000000):ℚ) := by decide +kernel

theorem physical_prediction {θ : ℝ} (hθ : |θ|≤(1/10:ℝ)) :
    (∃ X : VaryingRateBurn.Motion record.model θ, ∀ t ∈ Icc (0:ℝ) 1,
      (record.existenceFloor:ℝ)≤‖X.p t‖) ∧
    (∀ X : VaryingRateBurn.Motion record.model θ, ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-record.position θ t‖≤(record.positionError:ℝ) ∧
      ‖X.v t-record.velocity θ t‖/1200≤(record.velocityError:ℝ)) := by
  apply record.physical_prediction valid
  simpa only [record,Rat.cast_div,Rat.cast_one,Rat.cast_ofNat] using hθ

