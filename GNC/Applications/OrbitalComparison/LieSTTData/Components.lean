  phase2 := harmonic2_valid
  phase1_rate := by decide +kernel
  phase2_rate := by decide +kernel
  initial_p := by decide +kernel
  initial_v := by decide +kernel
  reduction := by intro i; fin_cases i; exact reduction_0; exact reduction_1; exact reduction_2
  position := checked_position
  first := checked_first
  second := checked_second
  residual := checked_residual
  first_force := checked_first_force
  second_force := checked_second_force
  position_pos := by decide +kernel
  position_max := by decide +kernel
  gain_nonnegative := by decide +kernel
  gain_max := by decide +kernel
  defect_nonnegative := by decide +kernel
  region := by decide +kernel
  existence_force := by decide +kernel
  existence_floor := by decide +kernel
  existence_gain := by decide +kernel

theorem position_display : record.positionError≤((1/1000000000):ℚ) := by decide +kernel
theorem velocity_display : record.velocityError≤((1/1000000000000):ℚ) := by decide +kernel

theorem physical_prediction {θ : ℝ} (hθ : |θ|≤(7/20:ℝ)) :
    (∃ X : VaryingRateBurn.Motion record.model θ, ∀ t ∈ Icc (0:ℝ) 1,
      (record.existenceFloor:ℝ)≤‖X.p t‖) ∧
    (∀ X : VaryingRateBurn.Motion record.model θ, ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-record.position θ t‖≤(record.positionError:ℝ) ∧
      ‖X.v t-record.velocity θ t‖/120≤(record.velocityError:ℝ)) := by
  apply record.physical_prediction valid
  simpa only [record,Rat.cast_div,Rat.cast_ofNat] using hθ

