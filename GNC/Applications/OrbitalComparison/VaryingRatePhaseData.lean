def initialRate : ℚ := 1200*(1077/1000000)
def rateSlope : ℚ := 1/2000
def phase (t : ℝ) : ℝ := (initialRate:ℝ)*t+(rateSlope:ℝ)*t^2/2

theorem phase_derivative (j : ℕ) (t : ℝ) :
    HasDerivAt (fun s => (j:ℝ)*phase s)
      ((j:ℝ)*((initialRate:ℝ)+(rateSlope:ℝ)*t)) t := by
  convert (((hasDerivAt_id t).const_mul (initialRate:ℝ)).add
    (((hasDerivAt_id t).pow 2).const_mul (rateSlope:ℝ) |>.div_const 2)).const_mul (j:ℝ) using 1
  dsimp [phase]
  ring

