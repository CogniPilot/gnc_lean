theorem prediction {θ : ℝ} (X : PhysicalOrbit .rtnInertialOffset θ) (hθ : |θ| ≤ 7/20) :
    ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-position SpatialSources.ordinary data.q θ t‖ ≤ (1656699/1000000000000) ∧
      ‖X.v t-velocity SpatialSources.ordinary data.q θ t‖/600 ≤ (1897871/100000000000000) := by
  have hp : (data.positionLimit:ℝ) = (1656699/1000000000000) := by norm_num [data]
  have hv : (data.velocityLimit:ℝ) = (1897871/100000000000000) := by norm_num [data]
  simpa only [hp,hv] using data.certifies SpatialSources.ordinary SpatialSources.polynomial24Time .rtnInertialOffset valid X
    (show |θ| ≤ (UniformCertificate.angle:ℝ) by simpa [UniformCertificate.angle] using hθ)

theorem relative_prediction {θ : ℝ} (X : PhysicalOrbit .rtnInertialOffset θ)
    (X₀ : PhysicalOrbit .rtnInertialOffset 0) (hθ : |θ| ≤ 7/20) :
    ∀ t ∈ Icc (0:ℝ) 1,
      ‖(X.p t-X₀.p t)-(position SpatialSources.ordinary data.q θ t-position SpatialSources.ordinary data.q 0 t)‖ ≤ 2*(1656699/1000000000000) ∧
      ‖(X.v t-X₀.v t)-(velocity SpatialSources.ordinary data.q θ t-velocity SpatialSources.ordinary data.q 0 t)‖/600 ≤ 2*(1897871/100000000000000) := by
  have hp : (data.positionLimit:ℝ) = (1656699/1000000000000) := by norm_num [data]
  have hv : (data.velocityLimit:ℝ) = (1897871/100000000000000) := by norm_num [data]
  simpa only [hp,hv] using data.relative_certifies SpatialSources.ordinary SpatialSources.polynomial24Time .rtnInertialOffset valid X X₀
    (show |θ| ≤ (UniformCertificate.angle:ℝ) by simpa [UniformCertificate.angle] using hθ)

