theorem prediction {θ : ℝ} (X : PhysicalOrbit .rtnInertialOffset θ) (hθ : |θ| ≤ 7/20) :
    ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-position SpatialSources.ordinary data.q θ t‖ ≤ (83611131/20000000000) ∧
      ‖X.v t-velocity SpatialSources.ordinary data.q θ t‖/600 ≤ (3877220623/50000000000000) := by
  have hp : (data.positionLimit:ℝ) = (83611131/20000000000) := by norm_num [data]
  have hv : (data.velocityLimit:ℝ) = (3877220623/50000000000000) := by norm_num [data]
  simpa only [hp,hv] using data.certifies SpatialSources.ordinary SpatialSources.polynomial24Time .rtnInertialOffset valid X
    (show |θ| ≤ (UniformCertificate.angle:ℝ) by simpa [UniformCertificate.angle] using hθ)

