theorem prediction {θ : ℝ} (X : SpatialFieldCertificate.PhysicalOrbit .rtnReferenceOffset θ) (hθ : |θ| ≤ 7/20) :
    ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-position SpatialSources.ordinary data.q θ t‖ ≤ (957869/1000000000000) ∧
      ‖X.v t-velocity SpatialSources.ordinary data.q θ t‖/600 ≤ (415093/100000000000000) := by
  have hp : (data.positionLimit:ℝ) = (957869/1000000000000) := by norm_num [data]
  have hv : (data.velocityLimit:ℝ) = (415093/100000000000000) := by norm_num [data]
  simpa only [hp,hv] using data.certifies SpatialSources.ordinary SpatialSources.polynomial24BernsteinTime valid X
    (show |θ| ≤ (UniformCertificate.angle:ℝ) by simpa [UniformCertificate.angle] using hθ)

