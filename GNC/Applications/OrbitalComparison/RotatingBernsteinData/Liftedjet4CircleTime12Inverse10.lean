theorem prediction {θ : ℝ} (X : SpatialFieldCertificate.PhysicalOrbit .rtnReferenceOffset θ) (hθ : |θ| ≤ 7/20) :
    ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-position SpatialSources.circle data.q θ t‖ ≤ (42533/62500000000) ∧
      ‖X.v t-velocity SpatialSources.circle data.q θ t‖/600 ≤ (1323/125000000000) := by
  have hp : (data.positionLimit:ℝ) = (42533/62500000000) := by norm_num [data]
  have hv : (data.velocityLimit:ℝ) = (1323/125000000000) := by norm_num [data]
  simpa only [hp,hv] using data.certifies SpatialSources.circle WeightedCertificate.circleBernsteinTime valid X
    (show |θ| ≤ (UniformCertificate.angle:ℝ) by simpa [UniformCertificate.angle] using hθ)

theorem relative_prediction {θ : ℝ} (X : SpatialFieldCertificate.PhysicalOrbit .rtnReferenceOffset θ)
    (X₀ : SpatialFieldCertificate.PhysicalOrbit .rtnReferenceOffset 0) (hθ : |θ| ≤ 7/20) :
    ∀ t ∈ Icc (0:ℝ) 1,
