def linearDefect : ℚ := (1821007449/24178516392292583494123520)
def quadraticDefect : ℚ := (590005954241/241785163922925834941235200)

theorem linear_budget_checked : (1/20:ℚ)*(∑ j, firstBudget j)=linearDefect := by decide +kernel
theorem quadratic_budget_checked : (1/400:ℚ)*(∑ j, secondBudget j)=quadraticDefect := by decide +kernel

theorem combined_linear_residual (w : Fin 8 → ℝ) (hw : ∀ j, |w j|≤1/20)
    {t : ℝ} (ht : t ∈ Icc (0:ℝ) 1) :
    enorm (combination (fun j => linearResidual K reference (first j) (sources j)) w t)≤
      (linearDefect:ℝ) := by
  have h := combination_bound (fun j => linearResidual K reference (first j) (sources j))
    w firstBudget (r := 1/20) (by norm_num) (by simpa using hw) all_linear_checked ht
  simpa only [linear_budget_checked] using h

theorem combined_quadratic_residual (w : Fin 8 → ℝ) (hw : ∀ j, |w j|≤1/20)
    {t : ℝ} (ht : t ∈ Icc (0:ℝ) 1) :
    enorm (combination (fun j => quadraticResidual K (factor j) reference
      (first (pairLeft j)) (first (pairRight j)) (second j))
      (fun j => w (pairLeft j)*w (pairRight j)) t)≤(quadraticDefect:ℝ) := by
  have hw' (j : Fin 36) : |w (pairLeft j)*w (pairRight j)|≤((1/400:ℚ):ℝ) := by
    rw [abs_mul]
    have h := mul_le_mul (hw (pairLeft j)) (hw (pairRight j)) (abs_nonneg _)
      (by norm_num : (0:ℝ)≤1/20)
    norm_num at h ⊢
    exact h
  have h := combination_bound (fun j => quadraticResidual K (factor j) reference
      (first (pairLeft j)) (first (pairRight j)) (second j))
    (fun j => w (pairLeft j)*w (pairRight j)) secondBudget (r := 1/400)
    (by norm_num) hw' all_quadratic_checked ht
  simpa only [quadratic_budget_checked] using h

end GNC.OrbitalComparison.CenteredResponseData
