/-! Generated by centered_response_export.py. Stored time coefficients are
untrusted proposals. Kernel checks cover their actual polynomial residuals
throughout [0,1], without an integration tolerance. Physical phase and
trajectory composition remain separate obligations. -/
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option Elab.async false
namespace GNC.OrbitalComparison.CenteredResponseData
open CartesianResponsePolynomial Matrix Set

theorem all_linear_checked : ∀ j,
    bound (linearResidual K reference (first j) (sources j))≤firstBudget j := by
  intro j
  fin_cases j
  · exact linear00_checked
  · exact linear01_checked
  · exact linear02_checked
  · exact linear03_checked
  · exact linear04_checked
  · exact linear05_checked
  · exact linear06_checked
  · exact linear07_checked

theorem all_quadratic_checked : ∀ j,
    bound (quadraticResidual K (factor j) reference
      (first (pairLeft j)) (first (pairRight j)) (second j))≤secondBudget j := by
  intro j
  fin_cases j
  · exact quadratic00_checked
  · exact quadratic01_checked
  · exact quadratic02_checked
  · exact quadratic03_checked
  · exact quadratic04_checked
  · exact quadratic05_checked
