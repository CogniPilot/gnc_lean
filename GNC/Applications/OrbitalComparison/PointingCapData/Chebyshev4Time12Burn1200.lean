      ‖X.v t-data.velocity x t‖/(600*(data.alpha:ℝ))≤(7052249/1000000000000) :=
  ⟨data.trajectory valid x hx,prediction hx (data.trajectory valid x hx)⟩

end GNC.OrbitalComparison.PointingCapData.Chebyshev4Time12Burn1200
