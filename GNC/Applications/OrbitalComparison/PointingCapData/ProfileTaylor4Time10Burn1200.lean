  have hv : (data.velocityError:ℝ)≤(((204359019/1000000000000):ℚ):ℝ) := by exact_mod_cast velocity_limit
  exact ⟨h.1.trans (by simpa using hp),h.2.trans (by simpa using hv)⟩

