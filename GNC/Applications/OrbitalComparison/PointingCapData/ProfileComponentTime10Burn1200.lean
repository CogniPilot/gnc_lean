theorem position_limit : data.positionError≤(23968331/250000000) := by decide +kernel
theorem velocity_limit : data.velocityError≤(202107881/1000000000000) := by decide +kernel

theorem prediction {x : Fin 3 → ℝ} (hx : Admissible (data.sigma:ℝ) x)
    (X : Motion (data.alpha:ℝ) (direction x)) :
    ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-data.position x t‖≤(23968331/250000000) ∧
      ‖X.v t-data.velocity x t‖/(600*(data.alpha:ℝ))≤(202107881/1000000000000) := by
  intro t ht
  have h := data.certifies valid hx X t ht
  have hp : (data.positionError:ℝ)≤(((23968331/250000000):ℚ):ℝ) := by exact_mod_cast position_limit
  have hv : (data.velocityError:ℝ)≤(((202107881/1000000000000):ℚ):ℝ) := by exact_mod_cast velocity_limit
  exact ⟨h.1.trans (by simpa using hp),h.2.trans (by simpa using hv)⟩

theorem physical_prediction {x : Fin 3 → ℝ} (hx : Admissible (data.sigma:ℝ) x) :
    ∃ X : Motion (data.alpha:ℝ) (direction x), ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-data.position x t‖≤(23968331/250000000) ∧
      ‖X.v t-data.velocity x t‖/(600*(data.alpha:ℝ))≤(202107881/1000000000000) :=
  ⟨data.trajectory valid x hx,prediction hx (data.trajectory valid x hx)⟩

end GNC.OrbitalComparison.PointingCapData.ProfileComponentTime10Burn1200
