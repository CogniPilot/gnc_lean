  change [BernsteinPolynomial.checked row_y0 (-angle) angle, BernsteinPolynomial.checked row_y1 (-angle) angle, BernsteinPolynomial.checked row_y2 (-angle) angle, BernsteinPolynomial.checked row_y3 (-angle) angle, BernsteinPolynomial.checked row_y4 (-angle) angle, BernsteinPolynomial.checked row_y5 (-angle) angle, BernsteinPolynomial.checked row_y6 (-angle) angle, BernsteinPolynomial.checked row_y7 (-angle) angle, BernsteinPolynomial.checked row_y8 (-angle) angle, BernsteinPolynomial.checked row_y9 (-angle) angle, BernsteinPolynomial.checked row_y10 (-angle) angle, BernsteinPolynomial.checked row_y11 (-angle) angle, BernsteinPolynomial.checked row_y12 (-angle) angle, BernsteinPolynomial.checked row_y13 (-angle) angle, BernsteinPolynomial.checked row_y14 (-angle) angle, BernsteinPolynomial.checked row_y15 (-angle) angle, BernsteinPolynomial.checked row_y16 (-angle) angle, BernsteinPolynomial.checked row_y17 (-angle) angle, BernsteinPolynomial.checked row_y18 (-angle) angle, BernsteinPolynomial.checked row_y19 (-angle) angle, BernsteinPolynomial.checked row_y20 (-angle) angle, BernsteinPolynomial.checked row_y21 (-angle) angle, BernsteinPolynomial.checked row_y22 (-angle) angle, BernsteinPolynomial.checked row_y23 (-angle) angle, BernsteinPolynomial.checked row_y24 (-angle) angle] = _
  rw [bound_y0, bound_y1, bound_y2, bound_y3, bound_y4, bound_y5, bound_y6, bound_y7, bound_y8, bound_y9, bound_y10, bound_y11, bound_y12, bound_y13, bound_y14, bound_y15, bound_y16, bound_y17, bound_y18, bound_y19, bound_y20, bound_y21, bound_y22, bound_y23, bound_y24]

private theorem conversion_residual_y :
    BernsteinTime.accepted (residualY polynomialRepresentation data.x data.y) (-angle) angle := by
  rw [residual_y_normalized]
  simp only [BernsteinTime.accepted, List.forall_mem_cons]
  exact ⟨accepted_y0, accepted_y1, accepted_y2, accepted_y3, accepted_y4, accepted_y5, accepted_y6, accepted_y7, accepted_y8, accepted_y9, accepted_y10, accepted_y11, accepted_y12, accepted_y13, accepted_y14, accepted_y15, accepted_y16, accepted_y17, accepted_y18, accepted_y19, accepted_y20, accepted_y21, accepted_y22, accepted_y23, accepted_y24, List.forall_mem_nil _⟩

private theorem forcing_dominates :
    PolynomialOrder.prefixes 0 (PolynomialBounds.subtract data.forcing
      (neededForcing polynomialBernsteinTime data.x data.y data.radius)) := by
  unfold neededForcing
  rw [residual_x_envelope, residual_y_envelope]
  decide +kernel
private theorem envelope_valid : PolynomialEnvelope.Valid data.forcing data.envelope := by decide +kernel
private theorem position_budget :
    Planning.PolynomialKernel.evaluate data.envelope 1 ≤ data.positionLimit := by decide +kernel
private theorem velocity_budget :
    Planning.PolynomialKernel.evaluate (Planning.PolynomialKernel.differentiate data.envelope) 1/600 ≤
      data.velocityLimit := by decide +kernel

theorem valid : data.Valid polynomialBernsteinTime :=
  ⟨radius_nonnegative, radius_below_centre, tube_inside_radius, gravity_gain,
    position_x_zero, position_y_zero, velocity_x_zero, velocity_y_zero,
    profile_x_zero, profile_y_zero, candidate_inside_radius, forcing_dominates,
    envelope_valid, position_budget, velocity_budget⟩
private theorem conversion_x : BernsteinTime.accepted data.x (-angle) angle := by decide +kernel
private theorem conversion_y : BernsteinTime.accepted data.y (-angle) angle := by decide +kernel
/-- Every Bernstein conversion was accepted by exact reconstruction. -/
theorem conversions_accepted :
    BernsteinTime.accepted data.x (-angle) angle ∧ BernsteinTime.accepted data.y (-angle) angle ∧
    BernsteinTime.accepted (residualX polynomialRepresentation data.x data.y) (-angle) angle ∧
    BernsteinTime.accepted (residualY polynomialRepresentation data.x data.y) (-angle) angle :=
  ⟨conversion_x, conversion_y, conversion_residual_x, conversion_residual_y⟩


theorem prediction {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E] (B : Plane E) {θ : ℝ}
    (X : PhysicalDeviation B.reference (B.force θ)) (hθ : |θ| ≤ 7/20) :
    ∀ t ∈ Icc (0:ℝ) 1,
      ‖X.p t-(curve polynomialRepresentation data.x data.y θ).position B t‖ ≤ (297/100000000) ∧
      ‖X.v t-(curve polynomialRepresentation data.x data.y θ).velocity B t‖/600 ≤ (177/5000000000) := by
  have hp : (data.positionLimit:ℝ) = (297/100000000) := by norm_num [data]
  have hv : (data.velocityLimit:ℝ) = (177/5000000000) := by norm_num [data]
  simpa only [hp,hv] using data.certifies polynomialBernsteinTime valid B X hθ

end GNC.OrbitalComparison.BernsteinData.STT8Time12
