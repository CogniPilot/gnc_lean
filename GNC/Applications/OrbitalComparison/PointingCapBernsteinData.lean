theorem sample_value : rationalValue (lifted base (1/10)) witnessA witnessB = sample := by
  decide +kernel
theorem witness_valid : |witnessA| ≤ 1 ∧ |witnessB| ≤ 1 := by decide +kernel

noncomputable section
theorem polynomial_upper (x : Fin 3 → ℝ) (hx : PointingCapBurn.Admissible (D.sigma:ℝ) x) :
    ParameterPolynomial.value (projection D) x 1 ≤ (upper:ℝ) := by
  rw [projection_identity]
  exact disk_upper base (by norm_num [D, PointingCapData.HornerTaylor4Time12Burn1200.data])
    tree upper checked hx.2.2.2

theorem physical_interval :
    (sample:ℝ)-(D.positionError:ℝ) ≤ support D ∧
      support D ≤ (upper:ℝ)+(D.positionError:ℝ) := by
  constructor
  · have h := polynomial_support_lower D PointingCapData.HornerTaylor4Time12Burn1200.valid rfl
      base projection_identity (by norm_num [D, PointingCapData.HornerTaylor4Time12Burn1200.data])
      (upper:ℝ) polynomial_upper witnessA witnessB witness_valid.1 witness_valid.2
    simpa only [show D.sigma=(1/10:ℚ) from rfl, sample_value] using h
  · exact support_upper D PointingCapData.HornerTaylor4Time12Burn1200.valid rfl _ polynomial_upper

def physicalLower : ℚ := sample-D.positionError
def physicalUpper : ℚ := upper+D.positionError
theorem width_below_centimetre : physicalUpper-physicalLower < 1/100 := by decide +kernel
def displayLower : ℚ := (105892991/125000)
def displayUpper : ℚ := (211788251/250000)
theorem display_outward : displayLower ≤ physicalLower ∧ physicalUpper ≤ displayUpper := by
  decide +kernel
theorem display_width : displayUpper-displayLower < 1/100 := by decide +kernel
theorem support_display : (displayLower:ℝ) ≤ support D ∧ support D ≤ (displayUpper:ℝ) := by
  have h := physical_interval
  have hl : (displayLower:ℝ) ≤ (sample:ℝ)-(D.positionError:ℝ) := by
    exact_mod_cast display_outward.1
  have hu : (upper:ℝ)+(D.positionError:ℝ) ≤ (displayUpper:ℝ) := by
    exact_mod_cast display_outward.2
  exact ⟨hl.trans h.1,h.2.trans hu⟩
end
