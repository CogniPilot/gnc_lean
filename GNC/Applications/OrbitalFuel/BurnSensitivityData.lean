theorem reported_matches (i : Fin 12) (j : Fin 18) (k : Fin 3) :
    (reported i j k:ℝ) = SharedBiasCertificates.Solar.h i j k := by
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    norm_num [reported, SharedBiasCertificates.Solar.h,
      Matrix.cons_val_two, Matrix.vecHead, Matrix.vecTail]

theorem output_certificate : ∀ i j k,
    (coefficient i j k).differenceMajorant (region j) allowance+
      |(coefficient i j k).ratValue (center j)-reported i j k| ≤ entryAllowance i j k := by
  decide +kernel

theorem vector_certificate : ∀ i j,
    0 ≤ vectorAllowance i j ∧
    (∑ k, (entryAllowance i j k)^2) ≤ (vectorAllowance i j)^2 := by decide +kernel

end GNC.Applications.OrbitalFuel.BurnSensitivity
