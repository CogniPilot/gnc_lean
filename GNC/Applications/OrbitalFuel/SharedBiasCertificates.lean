theorem strict_propellant_saving (y : Fin 18 → ℝ)
    (hy : IndependentFeasible axis kappa h b y)
    (hbox : ∀ j, 0 ≤ y j ∧ y j ≤ 1) (m exhaust : ℝ)
    (hm : 0 < m) (he : 0 < exhaust) :
    GNC.Propellant.consumedMass m exhaust (Cost c x) <
      GNC.Propellant.consumedMass m exhaust (Cost c y) :=
  GNC.Propellant.consumed_strictMono hm he (strict_cost_saving y hy hbox)
end Solar

