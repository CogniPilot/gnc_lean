theorem independent_lower (y : Fin 18 → ℝ)
    (hy : IndependentFeasible axis kappa h b y)
    (hbox : ∀ j, 0 ≤ y j ∧ y j ≤ 1) :
    (() : ℝ) ≤ Cost c y := by
