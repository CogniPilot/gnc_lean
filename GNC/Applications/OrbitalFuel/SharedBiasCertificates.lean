    (hy : IndependentFeasible axis kappa h b y)
    (hbox : ∀ j, 0 ≤ y j ∧ y j ≤ 1) :
    ((6390268981888780609742228312419470251793787398088651875914445423196963973512902719551/44445290443735629911226363018109781569099626183476677981624013000000000000000000000000) : ℝ) ≤ Cost c y := by
