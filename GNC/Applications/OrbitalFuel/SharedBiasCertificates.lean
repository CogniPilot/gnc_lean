theorem combined_value : ∀ i, combined (h i) x = g i := by
  intro i
  fin_cases i <;> ext k <;> fin_cases k <;>
    norm_num [combined, h, x, g, Fin.sum_univ_succ]

theorem support_certificate :
    (∀ i, 0 ≤ ell i) ∧ (∀ i, 0 ≤ s i) ∧
    (∀ i, GNC.lengthSq (g i+ell i • axis) ≤ (s i)^2) ∧
    (∀ i, s i-ell i*kappa ≤ b i) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  all_goals intro i; fin_cases i <;>
    norm_num [g, ell, s, axis, kappa, b, GNC.lengthSq, Fin.sum_univ_succ,
      Matrix.cons_val_two]

theorem common_feasible : CommonFeasible axis kappa h b x := by
  apply common_of_certificate axis kappa h b x ell s
    support_certificate.1 support_certificate.2.1
  · intro i
    rw [combined_value]
    exact support_certificate.2.2.1 i
  · exact support_certificate.2.2.2

theorem in_box : ∀ j, 0 ≤ x j ∧ x j ≤ 1 := by
